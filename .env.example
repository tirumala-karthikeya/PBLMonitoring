# PostgreSQL connection strings (this project uses a free Neon instance).
# DATABASE_URL: the pooled connection string, with &pgbouncer=true appended
#   (required so Prisma's queries work correctly behind Neon's PgBouncer pooler).
# DIRECT_URL: the direct (non-pooled) connection string, used only for migrations.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Optional: enables real Claude-generated narratives.
# If unset, narrative generation falls back to a deterministic template.
ANTHROPIC_API_KEY=""
